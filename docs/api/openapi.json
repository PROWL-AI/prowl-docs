      "WalletBalances": {
        "description": "The two pools a caller spends from, rounded to whole cents at this boundary.\n\nSub-cent precision is deliberate *inside* the store (SSH-305) and deliberately\nabsent here \u2014 `web/server.py::_rounded_wallet_fields` rounds on the way out so a\ndisplay value never carries a float tail.",
        "properties": {
          "extra_balance_usd": {
            "description": "Top-up credit. Never expires, spent after the subscription pool.",
            "title": "Extra Balance Usd",
            "type": "number"
          },
