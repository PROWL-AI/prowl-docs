          "markup_usd": {
            "description": "The difference between the two figures above.",
            "title": "Markup Usd",
            "type": "number"
          },
          "provider_cost_usd": {
            "description": "What the upstream provider charged for this call.",
            "title": "Provider Cost Usd",
            "type": "number"
          },
          "success": {
            "description": "Whether the provider returned a usable result.",
            "title": "Success",
            "type": "boolean"
          },
          "tool_name": {
            "description": "Registry name of the tool that was called.",
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "tool_name",
          "provider_cost_usd",
          "billed_usd",
          "markup_usd",
